# ==============================================================================
# 1. Python Virtual Environments & Installed Packages (8+ GB)
# ==============================================================================
.venv/
venv/
env/
ENV/
Lib/
share/
Include/
Scripts/
pyvenv.cfg

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.so

# ==============================================================================
# 2. Large Datasets (1.6+ GB, 53,000+ images)
# ==============================================================================
data/
dataset/
*.zip
*.tar.gz
*.tar
*.7z

# ==============================================================================
# 3. Intermediate Checkpoints & Heavy Export Binaries
# ==============================================================================
# Ignore intermediate training checkpoints
checkpoints/best.pt
checkpoints/last.pt
checkpoints/epoch_*.pt

# Keep official baseline checkpoint (78.4 MB is under GitHub's 100MB file limit)
!checkpoints/baseline_38class_effnetv2s.pt
!checkpoints/.gitkeep

# Ignore large exported binaries (TorchScript & ONNX)
outputs/exports/*.ts
outputs/exports/*.onnx
!outputs/exports/.gitkeep
!outputs/exports/*.md

# ==============================================================================
# 4. Logs, TensorBoard & Runtime Caches
# ==============================================================================
runs/
logs/
*.log
.pytest_cache/
.coverage
htmlcov/

# ==============================================================================
# 5. IDE, Editor & OS Artifacts
# ==============================================================================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
*.tmp
